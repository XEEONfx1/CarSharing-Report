-- Question 6e:
-- Analyze the month with the highest average demand in 2017.
-- Tasks:
-- 1. Find the month with the highest average demand.
-- 2. Analyze temperature categories in that month.
-- 3. Find the most prevalent weather condition.
-- 4. Calculate average, maximum, and minimum wind speed.
-- 5. Calculate average, maximum, and minimum humidity.
-- 6. Calculate average demand by temperature category.


-- Task 1: Find the month with the highest average demand in 2017

SELECT
    MONTHNAME(t.timestamp) AS month,
    ROUND(AVG(c.demand), 4) AS average_demand
FROM CarSharing_df AS c
JOIN time AS t
    ON c.id = t.id
WHERE YEAR(t.timestamp) = 2017
GROUP BY MONTH(t.timestamp), MONTHNAME(t.timestamp)
ORDER BY average_demand DESC
LIMIT 1;


-- Task 2: Temperature category frequency in July 2017

SELECT
    CASE
        WHEN CAST(SUBSTRING_INDEX(c.temp_code, '-', 1) AS DECIMAL(10,2)) < 10 THEN 'Cold'
        WHEN CAST(SUBSTRING_INDEX(c.temp_code, '-', 1) AS DECIMAL(10,2)) <= 25 THEN 'Mild'
        ELSE 'Hot'
    END AS temp_category,
    COUNT(*) AS frequency
FROM CarSharing_df AS c
JOIN time AS t
    ON c.id = t.id
WHERE YEAR(t.timestamp) = 2017
  AND MONTH(t.timestamp) = 7
GROUP BY temp_category
ORDER BY frequency DESC;


-- Task 3: Most prevalent weather condition in July 2017

SELECT
    w.weather,
    COUNT(*) AS frequency
FROM CarSharing_df AS c
JOIN time AS t
    ON c.id = t.id
JOIN weather AS w
    ON c.weather_code = w.weather_code
WHERE YEAR(t.timestamp) = 2017
  AND MONTH(t.timestamp) = 7
GROUP BY w.weather
ORDER BY frequency DESC
LIMIT 1;


-- Task 4: Wind speed in July 2017

SELECT
    ROUND(AVG(c.windspeed), 4) AS average_windspeed,
    MAX(c.windspeed) AS maximum_windspeed,
    MIN(c.windspeed) AS minimum_windspeed
FROM CarSharing_df AS c
JOIN time AS t
    ON c.id = t.id
WHERE YEAR(t.timestamp) = 2017
  AND MONTH(t.timestamp) = 7;


-- Task 5: Humidity in July 2017

SELECT
    ROUND(AVG(c.humidity), 4) AS average_humidity,
    MAX(c.humidity) AS maximum_humidity,
    MIN(c.humidity) AS minimum_humidity
FROM CarSharing_df AS c
JOIN time AS t
    ON c.id = t.id
WHERE YEAR(t.timestamp) = 2017
  AND MONTH(t.timestamp) = 7;


-- Task 6: Average demand by temperature category in July 2017

SELECT
    CASE
        WHEN CAST(SUBSTRING_INDEX(c.temp_code, '-', 1) AS DECIMAL(10,2)) < 10 THEN 'Cold'
        WHEN CAST(SUBSTRING_INDEX(c.temp_code, '-', 1) AS DECIMAL(10,2)) <= 25 THEN 'Mild'
        ELSE 'Hot'
    END AS temp_category,
    ROUND(AVG(c.demand), 4) AS average_demand
FROM CarSharing_df AS c
JOIN time AS t
    ON c.id = t.id
WHERE YEAR(t.timestamp) = 2017
  AND MONTH(t.timestamp) = 7
GROUP BY temp_category
ORDER BY average_demand DESC;
